[Unit]
Description=Tokyonight Desktop System Summary HUD
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %h/.local/share/tokyonight-hud/tokyonight_hud.py --daemon
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1
PassEnvironment=DISPLAY WAYLAND_DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE

[Install]
WantedBy=graphical-session.target
